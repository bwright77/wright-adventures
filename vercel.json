{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/discovery/sources-sync",
      "schedule": "0 8 * * 1"
    },
    {
      "path": "/api/notifications/deadlines",
      "schedule": "0 9 * * *"
    }
  ],
  "functions": {
    "api/discovery/sources-sync.ts": {
      "maxDuration": 300
    }
  }
}
